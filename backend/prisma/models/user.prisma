enum Gender {
  MALE
  FEMALE
}


model User {
  id        Int                       @id @default(autoincrement())
  email     String                    @unique
  name      String?
  username  String?                   @unique
  password  String?
  birthday  DateTime?
  photo     String?
  photoUrl  String?
  photoPublicId String?
  gender    Gender?
  countryCode String?
  city        String?
  isDeleted Boolean                   @default(false)
  lastSeen  DateTime?
  googleId  String?                   @unique
  createdAt DateTime                  @default(now())
  passwordChangedAt  DateTime?
  passwordResetOtpHash           String?
  passwordResetOtpExpiresAt      DateTime?
  passwordResetTokenHash         String?
  passwordResetTokenExpiresAt    DateTime?
  hasSeenOnboarding  Boolean @default(false)


  @@index([countryCode])
  @@index([countryCode, city])


  friendships Friendship[] @relation("UserFriendships")
  friends     Friendship[] @relation("UserFriends")
  sentRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedRequests FriendRequest[] @relation("ReceivedFriendRequests")
  chatParticipants ChatParticipant[]
  sentMessages     Message[]         @relation("SentMessages")
  messageStatuses  MessageStatus[]
  userLanguages UserLanguage[]
}


model UserLanguage {
  id          Int     @id @default(autoincrement())
  userId      Int
  languageCode String

  isLearning  Boolean @default(false)
  isSpeaking  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode])
}
